# Keep this file local. Never expose keys in browser code or commit .env.local.

# Option A: Claude (paid). When set, the assistant uses Claude.
# ANTHROPIC_API_KEY=your_key_here
# ANTHROPIC_MODEL=claude-opus-5-5

# Option B: free local model through Ollama (used when no ANTHROPIC_API_KEY is set).
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
